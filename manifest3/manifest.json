{
    "manifest_version": 3,
    "name": "noffyTranslate",
    "description": "Zmienia tekst na ffszystkich sstronach na noffonordacki w duchu głupkoffatości.",
    "version": "0.3.5",
    "icons": {
        "16": "logo/logo.png",
        "48": "logo/logo.png",
        "128": "logo/logo.png"
    },
    "content_scripts": [{
        "js": ["content.js"],
        "matches": ["<all_urls>"],
        "run_at": "document_end"
    }]
}